WEBHOOK_URL=http://localhost:5678

# Authentication
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=e5h388Mukm11b73IQp4Rm0868

# Earth Agents Integration
EARTH_AGENTS_API_URL=http://host.docker.internal:8080
EARTH_AGENTS_API_KEY=your-earth-agents-api-key
EARTH_AGENTS_ENV=development

# External Service Integrations
GITHUB_TOKEN=ghp_your_github_token
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repository-name

# Slack Integration
SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Notion Integration
NOTION_API_KEY=secret_your_notion_integration_key

# Monitoring & Alerting
DATADOG_API_KEY=your_datadog_api_key
PAGERDUTY_API_KEY=your_pagerduty_api_key

# Confluence Integration
CONFLUENCE_API_URL=https://your-domain.atlassian.net
CONFLUENCE_API_TOKEN=your_confluence_api_token
CONFLUENCE_SPACE=TECH

# Jira Integration
JIRA_API_URL=https://your-domain.atlassian.net
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=PROJ

# Security & Compliance
S3_COMPLIANCE_BUCKET=your-compliance-reports-bucket
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_REGION=us-east-1

# Figma Integration
FIGMA_FILE_KEY=your_figma_file_key
FIGMA_ACCESS_TOKEN=your_figma_access_token

# Elasticsearch Integration
ELASTICSEARCH_INDEX=earth-agents-knowledge
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=your_elasticsearch_api_key

# Performance & Logging
N8N_LOG_LEVEL=info
N8N_METRICS=true
EXECUTIONS_TIMEOUT=3600

# Email Configuration (optional)
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=smtp.gmail.com
N8N_SMTP_PORT=587
N8N_SMTP_USER=your-email@gmail.com
N8N_SMTP_PASS=your-app-password
N8N_SMTP_SENDER=your-email@gmail.com

# Advanced Configuration
N8N_PAYLOAD_DEFAULT_MAX_SIZE=16
N8N_ENCRYPTION_KEY=your-encryption-key-32-chars-long
GENERIC_TIMEZONE=America/New_York

# CLI Configuration
CLI_LOG_LEVEL=info
CLI_BACKUP_RETENTION_DAYS=30
CLI_HEALTH_CHECK_INTERVAL=300