{
  "name": "@earth-agents/n8n-cli",
  "version": "1.0.0",
  "description": "CLI tools for managing Earth Agents N8N workflows",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "mcp": "node mcp-server.js",
    "start": "docker-compose up -d",
    "stop": "docker-compose down",
    "restart": "docker-compose restart",
    "logs": "docker-compose logs -f",
    "setup": "./scripts/setup.sh",
    "deploy": "./scripts/deploy.sh",
    "backup": "./scripts/backup.sh",
    "restore": "./scripts/restore.sh",
    "health": "./scripts/health-check.sh",
    "import": "./scripts/import-workflows.sh",
    "export": "./scripts/export-workflows.sh",
    "activate": "./scripts/activate-workflows.sh",
    "deactivate": "./scripts/deactivate-workflows.sh",
    "monitor": "./scripts/monitor.sh",
    "test": "./scripts/test-workflows.sh"
  },
  "keywords": [
    "n8n",
    "earth-agents",
    "workflow",
    "automation",
    "cli"
  ],
  "author": "Earth Agents Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "commander": "^11.0.0",
    "dotenv": "^16.6.1",
    "inquirer": "^9.2.0",
    "ora": "^7.0.0",
    "table": "^6.8.0"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "jest": "^29.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/earth-agents/n8n-cli.git"
  },
  "bugs": {
    "url": "https://github.com/earth-agents/n8n-cli/issues"
  },
  "homepage": "https://github.com/earth-agents/n8n-cli#readme"
}
