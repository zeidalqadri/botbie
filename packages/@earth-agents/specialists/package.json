{
  "name": "@earth-agents/specialists",
  "version": "1.0.0",
  "description": "Specialist agents integration for Earth Agents ecosystem",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "activate": "node activate-claude-code.js",
    "claude:activate": "npm run build && node activate-claude-code.js",
    "claude:help": "node -e \"require('./dist/claude-code-bridge').help().then(console.log)\"",
    "claude:agents": "node -e \"require('./dist/claude-code-bridge').agents().then(console.log)\""
  },
  "dependencies": {
    "@earth-agents/core": "file:../core",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "jest": "^29.0.0"
  },
  "keywords": [
    "earth-agents",
    "specialists",
    "claude-code",
    "ai-agents"
  ]
}